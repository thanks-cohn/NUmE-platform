{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://numenume.com/schemas/nume-vendor-catalog.schema.v1.json","title":"NUME Vendor Catalog v1","type":"object","additionalProperties":false,
  "required":["schema_version","catalog_id","merchant_id","storefront_id","assigned_row_ids","currency","revision","updated_at","products","extensions"],
  "properties":{"schema_version":{"const":"1.0.0"},"catalog_id":{"$ref":"#/$defs/id"},"merchant_id":{"$ref":"#/$defs/id"},"storefront_id":{"$ref":"#/$defs/id"},"assigned_row_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"currency":{"$ref":"#/$defs/currency"},"revision":{"type":"integer","minimum":1},"updated_at":{"$ref":"#/$defs/time"},"products":{"type":"array","items":{"$ref":"#/$defs/product"}},"extensions":{"$ref":"#/$defs/extensions"}},
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$","minLength":3,"maxLength":128},"currency":{"type":"string","pattern":"^[a-z]{3}$"},"time":{"type":"string","format":"date-time"},
    "extensions":{"type":"object","propertyNames":{"pattern":"^[a-z][a-z0-9]*(?:\\.[a-z0-9_-]+)+$"},"additionalProperties":true},
    "money":{"type":"object","additionalProperties":false,"required":["amount_minor","currency"],"properties":{"amount_minor":{"type":"integer","minimum":0},"currency":{"$ref":"#/$defs/currency"}}},
    "externalReference":{"type":"object","additionalProperties":false,"required":["system","id"],"properties":{"system":{"type":"string","pattern":"^[a-z][a-z0-9_-]*$"},"id":{"type":"string","minLength":1,"maxLength":512},"account_id":{"type":["string","null"],"maxLength":512},"provider_id":{"type":["string","null"]},"url":{"type":["string","null"]},"active":{"type":"boolean"},"historical_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"extensions":{"$ref":"#/$defs/extensions"}}},
    "media":{"type":"object","additionalProperties":false,"required":["media_id","kind","url","alt","sort_order"],"properties":{"media_id":{"$ref":"#/$defs/id"},"kind":{"enum":["local","public_https","managed","provider"]},"url":{"type":"string","minLength":1,"maxLength":4096},"alt":{"type":"string","minLength":1,"maxLength":500},"sort_order":{"type":"integer","minimum":0},"extensions":{"$ref":"#/$defs/extensions"}}},
    "availability":{"type":"object","additionalProperties":false,"required":["status","checked_at"],"properties":{"status":{"enum":["available","low_stock","sold_out","temporarily_unavailable","preorder","discontinued","unknown","mapping_error","suspended"]},"quantity":{"type":["integer","null"],"minimum":0},"checked_at":{"$ref":"#/$defs/time"},"source":{"enum":["provider","merchant","nume","combined"]},"reason":{"type":["string","null"]}}},
    "fulfillment":{"type":"object","additionalProperties":false,"required":["provider","provider_product_id","provider_variant_id"],"properties":{"provider":{"type":"string","enum":["manual","printify","printful","gelato","gooten"]},"provider_product_id":{"type":"string","minLength":1},"provider_variant_id":{"type":"string","minLength":1},"provider_sku":{"type":["string","null"]},"extensions":{"$ref":"#/$defs/extensions"}}},
    "variant":{"type":"object","additionalProperties":false,"required":["variant_id","sku","title","options","active","retail_price","currency","availability","fulfillment_mapping","external_references","created_at","updated_at","extensions"],"properties":{"variant_id":{"$ref":"#/$defs/id"},"sku":{"type":"string","minLength":1,"maxLength":256},"title":{"type":"string","minLength":1},"options":{"type":"object","additionalProperties":{"type":"string"}},"active":{"type":"boolean"},"retail_price":{"$ref":"#/$defs/money"},"currency":{"$ref":"#/$defs/currency"},"availability":{"$ref":"#/$defs/availability"},"fulfillment_mapping":{"anyOf":[{"$ref":"#/$defs/fulfillment"},{"type":"null"}]},"external_references":{"type":"array","items":{"$ref":"#/$defs/externalReference"}},"created_at":{"$ref":"#/$defs/time"},"updated_at":{"$ref":"#/$defs/time"},"extensions":{"$ref":"#/$defs/extensions"}}},
    "product":{"type":"object","additionalProperties":false,"required":["product_id","storefront_id","row_ids","title","description","media","tags","variants","external_references","created_at","updated_at","active","status","extensions"],"properties":{"product_id":{"$ref":"#/$defs/id"},"storefront_id":{"$ref":"#/$defs/id"},"row_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"title":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"media":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/media"}},"tags":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"variants":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/variant"}},"external_references":{"type":"array","items":{"$ref":"#/$defs/externalReference"}},"created_at":{"$ref":"#/$defs/time"},"updated_at":{"$ref":"#/$defs/time"},"active":{"type":"boolean"},"status":{"enum":["draft","active","archived","suspended"]},"extensions":{"$ref":"#/$defs/extensions"}}}
  }
}
